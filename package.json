{
  "name": "shockwave",
  "version": "1.6.13",
  "description": "Local audio manager with a Spotify-like interface",
  "main": "./out/main/index.js",
  "author": "Matthew",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "npm run build && node scripts/stage-aftershock.mjs && node scripts/stage-adb.mjs && electron-builder --publish never",
    "dist:win": "npm run build && node scripts/stage-aftershock.mjs && node scripts/stage-adb.mjs && electron-builder --win nsis --publish never",
    "icon": "node scripts/generate-icon.mjs"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.8.11",
    "music-metadata": "^11.9.0"
  },
  "devDependencies": {
    "@types/discord-rpc": "^4.0.11",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
